# Copia este archivo a .env.local y completa los valores.
# Ninguna de estas variables lleva NEXT_PUBLIC_: son solo de servidor y nunca
# llegan al navegador.

# --- Panel /admin ---
ADMIN_PASSWORD=
# Opcional: si no se define, la cookie de sesión se firma derivando de ADMIN_PASSWORD.
ADMIN_SESSION_SECRET=

# --- Commit a GitHub al pulsar "Guardar" en /admin ---
GITHUB_TOKEN=
GITHUB_OWNER=ISAIASNIAUPARI
GITHUB_REPO=Nieve--Artesanal
GITHUB_BRANCH=main

# --- Cloudinary (subida de imágenes, video y modelos 3D optimizados desde /admin) ---
CLOUDINARY_CLOUD_NAME=foewxv45
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Vercel Blob (subida temporal del .glb crudo antes de optimizarlo — ver
# app/api/admin/upload-3d-token/route.ts). Se genera solo al conectar un Blob
# store al proyecto en Vercel (Storage → Create Database → Blob); no hace
# falta copiarla a mano en producción, pero si se prueba en local hay que
# pegarla acá (Vercel dashboard → Storage → el store → .env.local tab).
BLOB_READ_WRITE_TOKEN=
